<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JD Mart | Checkout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
    <link rel="stylesheet" href="/css/checkout.css">
    <link rel="stylesheet" href="/css/style.css">

  
</head>

<body>
<nav class="navbar navbar-expand-lg navbar-light bg-body-light border-bottom sticky-top">
  <div class="container-fluid">

    <!-- LOGO -->
    <a class="navbar-brand d-flex align-items-center" href="/">
      <img src="/images/image.png" alt="JD Mart Logo" height="40" style="border-radius: 8px;"/>
      <span class="ms-2 fw-bold">JD Mart</span>
    </a>

    <!-- LOCATION -->
    <div class="ms-auto me-4 d-flex align-items-center">
      <i class="fa-solid fa-location-dot me-1" style="color: #16a34a;"></i>
      <span id="locationText" style="font-size: 15px;">Getting location...</span>
    </div>

    <!-- REST OF NAVBAR -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-search ms-3">
        <input type="text" id="productSearch" placeholder="Search for crops, grains, vegetables..." class="form-control" />
      </div>

      <div class="navbar-icons ms-3">
        <a href="/notifications" class="position-relative me-3">
            
            <i class="fa-regular fa-bell fa-lg"></i>
            <% 
              // Show unread count if any 
              const unreadCount = notifications?.filter(n => n.status === "unread").length || 0; 
            %>
            <% if(unreadCount > 0) { %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                <%= unreadCount %>
              </span>
            <% } %>
            
          </a>
        
          <a href="/browse-products">
            <i class="fa-solid fa-cart-shopping"></i> 
          </a>

        <!-- USER DROPDOWN -->
        <div class="navbar-user" id="userDropdown">
          <div class="avatar">
            <%= user?.fullName?.charAt(0).toUpperCase() || "U" %>
          </div>
          <span><%= user?.fullName?.split(" ")[0] || "Guest" %></span>
          <i class="fa-solid fa-chevron-down"></i>

          <div class="jd-user-menu">
            <div class="jd-user-info">
              <strong><%= user?.fullName || "Guest User" %></strong>
              <small><%= user?.email || "Not logged in" %></small>
            </div>
            <a href="/profile"><i class="fa-regular fa-user"></i> Profile</a>
            <a href="/orders"><i class="fa-solid fa-box"></i> Orders</a>
            <div class="jd-divider"></div>
            <a href="/logout" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</nav>

   <!-- STEPS -->
  <!-- STEPS -->
  <div class="checkout-steps">

  <!-- CART -->
  <a href="/checkout/<%= product._id %>?qty=<%= qty %>" class="step-link">
    <div class="step active">
      <i class="bi bi-cart"></i> Cart
    </div>
  </a>

  <div class="step-line"></div>

  <!-- ADDRESS -->
    <div class="step">
      <i class="bi bi-geo-alt"></i> Address
    </div>

  <div class="step-line"></div>

  <!-- REVIEW (current) -->
  <div class="step">
    <i class="bi bi-card-text"></i> Review
  </div>

</div>

<!-- CONTENT -->
<div class="container-wrapper"> <!-- NEW WRAPPER FOR HORIZONTAL CENTERING -->

  <div class="container-wide"> <!-- max-width, centered -->
    <div class="checkout-layout">

      <!-- LEFT: CART -->
      <div class="cart-card">
        <div class="cart-left">
          <div class="product-img">🌾</div>

          
          <div>
            <!-- <label>Quantity (quintals)</label> -->
            <h5 class="mb-1"><%= product.name %></h5>
            <div class="text-muted">₹<%= product.pricePerQuintal.toLocaleString("en-IN") %> per quintal</div>

            <div class="qty-control">
              <button class="qty-btn" data-action="decrease">−</button>
              <input 
                type="number"
                id="qtyInput"
                value="<%= qty %>"
                min="1"
                max="<%= product.available %>"
                readonly
              >
              <button class="qty-btn" data-action="increase">+</button>
            </div>
          </div>
        </div>

        <div class="cart-price">
          ₹<span id="subtotal"><%= subtotal.toLocaleString("en-IN") %></span>
        </div>
      </div>

      <!-- RIGHT: SUMMARY -->
      <div class="summary-card">
        <h4 class="mb-4">Order Summary</h4>

        <div class="summary-row">
          <span>Subtotal</span>
          <span id="summarySubtotal">₹<%= subtotal.toLocaleString("en-IN") %></span>
        </div>

        <div class="summary-row">
          <span>Delivery Fee</span>
          <span>
            <%= deliveryFee === 0 ? "Free" : "₹" + deliveryFee.toLocaleString("en-IN") %>
          </span>
        </div>

        <hr>

        <div class="summary-total">
          <span>Total</span>
          <span>₹<span id="total"><%= total.toLocaleString("en-IN") %></span></span>
        </div>

        <form action="/orders/place/<%= product._id %>" method="POST">
          <input type="hidden" name="qty" id="hiddenQty" value="<%= qty %>">
          <button class="checkout-btn">Proceed to Checkout →</button>
        </form>

        <form action="/checkout/address/<%= product._id %>" method="GET" style="margin-top: 12px;">
          <input type="hidden" name="qty" id="addressQty" value="<%= qty %>">
          <button class="btn btn-success w-100">Continue to Address →</button>
        </form>

      </div>

    </div>
  </div>
</div>


  <script>
  const PRICE_PER_QUINTAL = <%= product.pricePerQuintal %>;
  const MAX_QTY = <%= product.available %>;
  const FREE_DELIVERY_LIMIT = 5000;
  const DELIVERY_CHARGE = 150;
</script>


 <script>
  const summarySubtotalEl = document.getElementById("summarySubtotal");
  const qtyInput = document.getElementById("qtyInput");
  const hiddenQty = document.getElementById("hiddenQty");
  const subtotalEl = document.getElementById("subtotal");
  const totalEl = document.getElementById("total");

  function updateUI(qty) {
    document.getElementById("addressQty").value = qty;
    qty = Math.max(1, Math.min(MAX_QTY, qty));

    // Update quantity
    qtyInput.value = qty;
    hiddenQty.value = qty;

    // Calculate subtotal
    const subtotal = qty * PRICE_PER_QUINTAL;

    // Calculate delivery
    const deliveryFee =
      subtotal >= FREE_DELIVERY_LIMIT ? 0 : DELIVERY_CHARGE;

    // Calculate total
    const total = subtotal + deliveryFee;

    // Update UI
    subtotalEl.textContent = subtotal.toLocaleString("en-IN");
    totalEl.textContent = total.toLocaleString("en-IN");

    summarySubtotalEl.textContent = subtotal.toLocaleString("en-IN");
    
    // Update delivery text
    document.querySelectorAll(".summary-row span:last-child")[1]
      .textContent = deliveryFee === 0
        ? "Free"
        : "₹" + deliveryFee.toLocaleString("en-IN");
  }

  document.querySelectorAll(".qty-btn").forEach(btn => {
    btn.addEventListener("click", e => {
      e.preventDefault();
      let qty = parseInt(qtyInput.value);

      if (btn.dataset.action === "increase") qty++;
      if (btn.dataset.action === "decrease") qty--;

      updateUI(qty);
    });
  });

  // Safety: ensure correct qty is sent
  document.querySelectorAll("form").forEach(form => {
    form.addEventListener("submit", () => {
      hiddenQty.value = qtyInput.value;
    });
  });
</script>
<script src="/js/script.js"></script>
</body>
</html>
