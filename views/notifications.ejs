<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JD Mart | Notifications</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/checkout.css">

  <style>
    body {
      background: #f9faf7;
      font-family: "Inter", sans-serif;
    }

    .notifications-wrapper {
      max-width: 900px;
      margin: 50px auto;
      padding: 0 15px;
    }

    .notification-card {
      background: #fff;
      border-radius: 12px;
      padding: 16px 20px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-left: 5px solid transparent;
      transition: background 0.2s, border-left 0.2s;
    }

    .notification-card.unread {
      background: #e6f8e6;
      border-left-color: #28a745;
    }

    .notification-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .notification-left i {
      font-size: 1.5rem;
      color: #28a745;
    }

    .notification-content h5 {
      margin: 0;
      font-size: 16px;
      font-weight: 600;
    }

    .notification-content p {
      margin: 4px 0 0;
      font-size: 14px;
      color: #555;
    }

    .notification-right span {
      font-size: 12px;
      color: #999;
    }

    .no-notifications {
      text-align: center;
      padding: 40px 20px;
      background: #fff;
      border-radius: 12px;
      font-size: 16px;
      color: #666;
    }
  </style>
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-light bg-body-light border-bottom sticky-top">
  <div class="container-fluid">

    <!-- LOGO -->
    <a class="navbar-brand d-flex align-items-center" href="/products">
      <img src="/images/image.png" alt="JD Mart Logo" height="40" style="border-radius: 8px;"/>
      <span class="ms-2 fw-bold">JD Mart</span>
    </a>

    <!-- LOCATION -->
    <div class="ms-auto me-4 d-flex align-items-center">
      <i class="fa-solid fa-location-dot me-1" style="color: #16a34a;"></i>
      <span id="locationText" style="font-size: 15px;">Getting location...</span>
    </div>

    <!-- REST OF NAVBAR -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-search ms-3">
        <input type="text" id="productSearch" placeholder="Search for crops, grains, vegetables..." class="form-control" />
      </div>

      <div class="navbar-icons ms-3">
        
          <!-- <i class="fa-regular fa-bell"></i> -->
       
          <a href="/notifications" class="position-relative me-3">
            
            <i class="fa-regular fa-bell fa-lg"></i>
            <% 
              // Show unread count if any 
              const unreadCount = notifications?.filter(n => n.status === "unread").length || 0; 
            %>
            <% if(unreadCount > 0) { %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                <%= unreadCount %>
              </span>
            <% } %>
            
          </a>
        
          <a href="/browse-products">
            <i class="fa-solid fa-cart-shopping"></i> 
          </a>


        <!-- USER DROPDOWN -->
    <div class="navbar-user" id="userDropdown" onclick="toggleUserDropdown()">
      <div class="avatar">
        <%= user?.fullName?.charAt(0).toUpperCase() || "U" %>
      </div>
      <span><%= user?.fullName?.split(" ")[0] || "Guest" %></span>
      <i class="fa-solid fa-angle-down toggle-icon"></i>

      <div class="jd-user-menu">
        <div class="jd-user-info">
          <strong><%= user?.fullName || "Guest User" %></strong>
          <small><%= user?.email || "Not logged in" %></small>
        </div>
        <a href="/profile"><i class="fa-regular fa-user"></i> Profile</a>
        <a href="/orders"><i class="fa-solid fa-box"></i> Orders</a>
        <div class="jd-divider"></div>
        <a href="/logout" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
      </div>
    </div>

      </div>

    </div>
  </div>
</nav>

<div class="notifications-wrapper">
  <h2 class="mb-4">Notifications</h2>

  <% if (notifications.length === 0) { %>
    <div class="no-notifications">
      You have no notifications yet.
    </div>
  <% } else { %>
    <% notifications.forEach(n => { %>
      <div class="notification-card <%= n.status === 'unread' ? 'unread' : '' %>">
        <div class="notification-left">
          <i class="fa-solid fa-bell"></i>
          <div class="notification-content">
            <h5>Order <%= n.orderId %> - <%= n.title %></h5>
            <p><%= n.message %></p>
          </div>
        </div>
        <div class="notification-right">
          <span><%= new Date(n.createdAt).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" }) %></span>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<script src="/js/script.js"></script>
</body>
</html>
