<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JD Mart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   
    <link rel="stylesheet" href="/css/checkout.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-body-light border-bottom sticky-top">
  <div class="container-fluid">

    <!-- LOGO -->
    <a class="navbar-brand d-flex align-items-center" href="/">
      <img src="/images/image.png" alt="JD Mart Logo" height="40" style="border-radius: 8px;"/>
      <span class="ms-2 fw-bold">JD Mart</span>
    </a>

    <!-- LOCATION -->
    <div class="ms-auto me-4 d-flex align-items-center">
      <i class="fa-solid fa-location-dot me-1" style="color: #16a34a;"></i>
      <span id="locationText" style="font-size: 15px;">Getting location...</span>
    </div>

    <!-- REST OF NAVBAR -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-search ms-3">
        <input type="text" id="productSearch" placeholder="Search for crops, grains, vegetables..." class="form-control" />
      </div>

      <div class="navbar-icons ms-3">
        <a href="/notifications" class="position-relative me-3">
            
            <i class="fa-regular fa-bell fa-lg"></i>
            <% 
              // Show unread count if any 
              const unreadCount = notifications?.filter(n => n.status === "unread").length || 0; 
            %>
            <% if(unreadCount > 0) { %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                <%= unreadCount %>
              </span>
            <% } %>
            
          </a>
        
          <a href="/browse-products">
            <i class="fa-solid fa-cart-shopping"></i> 
          </a>

        <!-- USER DROPDOWN -->
    <div class="navbar-user" id="userDropdown" onclick="toggleUserDropdown()">
      <div class="avatar">
        <%= user?.fullName?.charAt(0).toUpperCase() || "U" %>
      </div>
      <span><%= user?.fullName?.split(" ")[0] || "Guest" %></span>
      <i class="fa-solid fa-angle-down toggle-icon"></i>

      <div class="jd-user-menu">
        <div class="jd-user-info">
          <strong><%= user?.fullName || "Guest User" %></strong>
          <small><%= user?.email || "Not logged in" %></small>
        </div>
        <a href="/profile"><i class="fa-regular fa-user"></i> Profile</a>
        <a href="/orders"><i class="fa-solid fa-box"></i> Orders</a>
        <div class="jd-divider"></div>
        <a href="/logout" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
      </div>
    </div>

      </div>

    </div>
  </div>
</nav>

<!-- SUCCESS CARD -->
<div class="container success-wrapper">
  <div class="success-card">

    <div class="check-circle">
      <i class="fa-regular fa-check-circle"></i>
    </div>

    <h2>Order Placed!</h2>
    <p>Your order has been successfully placed</p>

    <div class="order-id">
      Order ID: <span><%= order.orderId %></span>
    </div>

    <div class="btn-group-custom">
      <button 
        class="btn btn-outline-success"
        onclick="window.location.href='/orders'"
      >
        <i class="fa-solid fa-cube"></i> View Orders
      </button>

      <button 
        class="btn btn-success"
        onclick="window.location.href='/products'"
      >
        Continue Shopping
      </button>
    </div>

  </div>
</div>

<!-- TOAST -->
<div class="toast-custom">
  <i class="bi bi-check-circle-fill"></i>
  <span>
    Order <strong><%= order.orderId %></strong> placed successfully!
  </span>
</div>

</body>
</html>
