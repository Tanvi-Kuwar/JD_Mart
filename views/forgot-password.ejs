<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>JD Mart | Forgot Password</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/forgot-password.css">
</head>
<body>

<div class="container">

  <!-- LEFT PANEL -->
  <div class="left-panel">
    <div class="brand">
      <img src="/images/image.png" alt="JD Mart Logo" height="40" style="border-radius: 8px;"/>
      <div>
        <h3>JD Mart</h3>
        <span>Buyer Portal</span>
      </div>
    </div>

    <h1>
      Secure Access to<br>
      Your JD Mart Account
    </h1>

    <p>
      Reset your password securely and get back to sourcing premium crops from verified farmers.
    </p>

    <ul class="features">
      <li>✔ OTP-based verification</li>
      <li>✔ Encrypted password reset</li>
      <li>✔ Secure account recovery</li>
      <li>✔ 24/7 support</li>
    </ul>
  </div>

  <!-- RIGHT PANEL -->
  <div class="right-panel">

    <div class="top-bar">
      <a href="/login">← Back to Login</a>
    </div>

    <h2>Forgot Password</h2>
    <p class="subtitle">We’ll help you reset your account access</p>

    <form action="/forgot-password" method="POST">

      <div class="input-group">
        <label>Email or Phone</label>
        <input 
          type="text" 
          name="login" 
          placeholder="Enter your email or phone"
          required
        />
      </div>

      <button class="btn" type="submit">
        Send Reset Link →
      </button>

    </form>

    <div class="helper-box">
      <strong>How it works</strong>
      <p>
        We'll send a secure reset link or OTP to your registered email or mobile number.
        Follow the instructions to create a new password.
      </p>
    </div>

    <p class="login-link">
      Remembered your password?
      <a href="/login">Sign In</a>
    </p>

  </div>

</div>

</body>
</html>
