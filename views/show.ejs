<script>
  const PRICE_PER_QUINTAL = <%= product.pricePerQuintal %>;
  const MAX_QTY = <%= product.available %>;
</script>


<script>
  const qtyInput = document.getElementById("qtyInput");
  const hiddenQty = document.getElementById("hiddenQty");
  const totalPriceEl = document.getElementById("totalPrice");

  function updateUI(qty) {
    qty = Math.max(1, Math.min(MAX_QTY, qty));

    qtyInput.value = qty;
    hiddenQty.value = qty;

    const total = qty * PRICE_PER_QUINTAL;
    totalPriceEl.textContent = total.toLocaleString("en-IN");
  }

  document.querySelectorAll(".jd-step").forEach(btn => {
    btn.addEventListener("click", () => {
      let qty = parseInt(qtyInput.value);

      if (btn.dataset.action === "inc") qty++;
      if (btn.dataset.action === "dec") qty--;

      updateUI(qty);
    });
  });

  // Safety: make sure correct qty is sent on submit
  document.querySelector("form").addEventListener("submit", () => {
    hiddenQty.value = qtyInput.value;
  });
</script>


</body>
</html>
